id: ap
name: Accounts Payable System
instructions: >
  Supplier invoices, payments, rebates, and vendor master controls.
  Invoice ids look like INV-000123, payment runs like RUN-000456, vendors VND-000123 (VND-000053 is SUP-0053),
  carrier vendors VND-0001nn. Carrier invoices carry carrier_id (CAR-002), air freight carries the causing supplier_id.
  Use it for invoice approval, payment scheduling, fraud checks,
  carrier disputes, rebate tracking, and vendor master data controls.

tables:
  vendors:
    key: vendor_id
    cols:
      vendor_id: {type: str, desc: "Vendor, e.g. VND-000123"}
      supplier_id: {type: str, desc: "Link to master supplier, e.g. SUP-0042; blank for carrier vendors"}
      carrier_id: {type: str, desc: "Link to master carrier, e.g. CAR-002; blank for suppliers"}
      name: {type: str, desc: Vendor name}
      country: {type: str, desc: ISO country code}
      bank_country: {type: str, desc: ISO country code of bank account}
      tax_id: {type: str, desc: "Tax ID / VAT number"}
      payment_terms_days: {type: int, desc: Standard payment terms in days}
      on_payment_hold: {type: bool, desc: Whether vendor is on payment hold}
      hold_reason: {type: str, desc: Reason for payment hold}
      hold_date: {type: date, desc: Date the payment hold was placed}
      fraud_risk_score: {type: int, desc: "Fraud risk score 0-100"}
      fraud_indicators: {type: list, desc: "List of fraud risk indicators"}
      control_approvals_required: {type: int, desc: Number of approvals required for bank detail changes}
      created_date: {type: date, desc: Date the vendor record was created}
      updated_at: {type: timestamp, desc: Last updated}

  bank_detail_changes:
    key: change_id
    cols:
      change_id: {type: str, desc: "Change request, e.g. BDC-000123"}
      vendor_id: {type: str, desc: Vendor}
      old_bank_account: {type: str, desc: Previous bank account}
      new_bank_account: {type: str, desc: New bank account}
      old_bank_country: {type: str, desc: Previous bank country}
      new_bank_country: {type: str, desc: New bank country}
      requested_date: {type: date, desc: When the change was requested}
      requested_by: {type: str, desc: Employee who requested}
      approval_status: {type: enum, values: [pending, approved, rejected], desc: Approval status}
      approvals_count: {type: int, desc: Number of approvals received}
      first_payment_date: {type: date, desc: Date of first payment to new account}
      updated_at: {type: timestamp, desc: Last updated}

  invoices:
    key: invoice_id
    cols:
      invoice_id: {type: str, desc: "Invoice, e.g. INV-000123"}
      vendor_id: {type: str, desc: Vendor}
      supplier_id: {type: str, desc: "Link to master supplier; blank for carrier and freight invoices"}
      carrier_id: {type: str, desc: "Carrier or forwarder that billed a carrier or freight invoice, e.g. CAR-002"}
      invoice_type: {type: enum, values: [supplier, carrier, freight, accrual], desc: Invoice type}
      invoice_number: {type: str, desc: Vendor's invoice number}
      invoice_date: {type: date, desc: Invoice date}
      received_date: {type: date, desc: Date received in AP system}
      amount_gbp: {type: float, desc: Invoice amount in GBP}
      po_id: {type: str, desc: "Associated PO, if any"}
      three_way_match_status: {type: enum, values: [pending, matched, variance, disputed], desc: GRN vs PO vs Invoice matching}
      gl_account: {type: str, desc: "GL account code (if coded)"}
      cost_centre_id: {type: str, desc: "Cost centre (if assigned)"}
      accrued: {type: bool, desc: Whether invoice is accrued}
      accrual_date: {type: date, desc: Date accrual was posted}
      payment_status: {type: enum, values: [open, scheduled, paid, disputed, on_hold], desc: Payment status}
      payment_run_id: {type: str, desc: "Payment run scheduled in, if any"}
      scheduled_payment_date: {type: date, desc: When scheduled to be paid}
      actual_payment_date: {type: date, desc: When actually paid}
      dispute_reason: {type: str, desc: Reason if disputed}
      description: {type: str, desc: What the invoice is for}
      created_date: {type: date, desc: When record created}
      updated_at: {type: timestamp, desc: Last updated}

  invoice_lines:
    key: [invoice_id, line_no]
    cols:
      invoice_id: {type: str, desc: Invoice}
      line_no: {type: int, desc: Line number}
      description: {type: str, desc: Line description}
      quantity: {type: float, desc: Quantity}
      unit_price_gbp: {type: float, desc: Unit price in GBP}
      line_total_gbp: {type: float, desc: Line total in GBP}
      charge_type: {type: str, desc: "Charge type, e.g. freight, surcharge, accessorial, weight_variance"}
      contracted_rate_gbp: {type: float, desc: "Contracted rate if applicable"}
      variance_gbp: {type: float, desc: "Variance from contracted rate"}
      variance_pct: {type: float, desc: "Variance percentage"}
      disputable: {type: bool, desc: Whether line is disputable}

  rebate_agreements:
    key: agreement_id
    cols:
      agreement_id: {type: str, desc: "Rebate agreement, e.g. RBA-000123"}
      supplier_id: {type: str, desc: Supplier}
      rebate_type: {type: enum, values: [volume, cost_reduction, quality_bonus], desc: Type of rebate}
      threshold_amount_gbp: {type: float, desc: Threshold annual spend}
      rebate_pct: {type: float, desc: "Rebate percentage above threshold"}
      rebate_amount_gbp: {type: float, desc: "Fixed rebate amount if applicable"}
      effective_from: {type: date, desc: Start date}
      effective_to: {type: date, desc: End date}
      status: {type: enum, values: [active, expired, suspended], desc: Agreement status}
      created_date: {type: date, desc: When created}

  rebate_accruals:
    key: accrual_id
    cols:
      accrual_id: {type: str, desc: "Accrual record, e.g. ACR-000123"}
      agreement_id: {type: str, desc: Rebate agreement}
      supplier_id: {type: str, desc: Supplier}
      accrual_period: {type: str, desc: "Period covered, e.g. FY2026-Q3"}
      ytd_spend_gbp: {type: float, desc: Year-to-date spend}
      accrued_amount_gbp: {type: float, desc: Cumulative rebate accrued at period end}
      settled_amount_gbp: {type: float, desc: Amount settled by the supplier}
      accrual_date: {type: date, desc: When accrual was posted}
      settlement_date: {type: date, desc: When settled}
      status: {type: enum, values: [accrued, settled], desc: Status}

  payment_runs:
    key: payment_run_id
    cols:
      payment_run_id: {type: str, desc: "Payment run, e.g. RUN-000123"}
      run_date: {type: date, desc: Planned payment date}
      run_type: {type: enum, values: [regular, ad_hoc, urgent], desc: Type of run}
      invoices_count: {type: int, desc: Number of invoices in run}
      total_amount_gbp: {type: float, desc: Total payment amount}
      status: {type: enum, values: [draft, scheduled, processing, completed, cancelled], desc: Run status}
      cancellation_reason: {type: str, desc: Reason if cancelled}
      created_date: {type: date, desc: When run was created}
      created_by: {type: str, desc: Employee who created}
      updated_at: {type: timestamp, desc: Last updated}

  supplier_payments:
    key: payment_id
    cols:
      payment_id: {type: str, desc: "Payment record, e.g. PAY-000123"}
      supplier_id: {type: str, desc: Supplier}
      vendor_id: {type: str, desc: Vendor}
      invoice_id: {type: str, desc: Invoice paid}
      amount_gbp: {type: float, desc: Payment amount in GBP}
      payment_date: {type: date, desc: Payment date}
      payment_run_id: {type: str, desc: Payment run}
      days_to_pay: {type: int, desc: Days from invoice date to payment date}
      bank_account: {type: str, desc: Bank account paid to}

  goods_receipt_invoice_variance:
    key: variance_id
    cols:
      variance_id: {type: str, desc: "Variance record, e.g. VAR-000123"}
      po_id: {type: str, desc: Purchase order}
      invoice_id: {type: str, desc: Associated invoice}
      grn_quantity: {type: int, desc: Goods receipt quantity}
      invoice_quantity: {type: int, desc: Invoiced quantity}
      quantity_variance: {type: int, desc: Difference in quantity}
      grn_amount_gbp: {type: float, desc: GRN amount}
      invoice_amount_gbp: {type: float, desc: Invoice amount}
      amount_variance_gbp: {type: float, desc: Difference in amount}
      variance_type: {type: enum, values: [quantity, price, both], desc: Type of variance}
      status: {type: enum, values: [pending, investigated, resolved, disputed], desc: Variance status}
      created_date: {type: date, desc: When variance detected}

  air_freight_invoices:
    key: invoice_id
    cols:
      invoice_id: {type: str, desc: "Freight invoice, e.g. FRT-000123"}
      supplier_id: {type: str, desc: "Supplier whose goods were flown (the cause), e.g. SUP-0012"}
      carrier_id: {type: str, desc: "Airline or forwarder that billed the flight, e.g. CAR-008"}
      invoice_date: {type: date, desc: Invoice date}
      amount_gbp: {type: float, desc: Invoice amount in GBP}
      shipment_count: {type: int, desc: Number of shipments}
      air_reason: {type: enum, values: [demand_spike, store_emergency, supplier_late, quality_issue, cancelled_order, other], desc: Reason for air freight}
      avoidable: {type: bool, desc: Whether cost is avoidable}
      avoidable_pct: {type: float, desc: "Percentage of the invoice that was avoidable, 0-100"}
      chargeability: {type: enum, values: [chargeable_to_supplier, no_chargeable_position, other], desc: Chargeable to supplier}
      contract_rate_gbp: {type: float, desc: "Rate per shipment under contract"}
      overcharge_gbp: {type: float, desc: "Amount over contracted rate"}
      status: {type: enum, values: [open, chargeable_drafted, chargeback_sent, disputed, closed], desc: Status}
      created_date: {type: date, desc: When record created}
