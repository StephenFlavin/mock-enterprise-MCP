id: marketplace
name: Marketplace Seller Portal
instructions: >
  Multi-channel e-commerce marketplace listings, requirements, policies and fees.
  Listing ids look like LST-000123. Use for marketplace compliance, content requirements,
  policy changes, fee impact analysis and listing rejections.

tables:
  marketplace_listings:
    key: listing_id
    cols:
      listing_id: {type: str, desc: "Marketplace listing, e.g. LST-000123"}
      sku: {type: str, desc: "SKU being listed, e.g. K-1700"}
      marketplace_id: {type: str, desc: "Marketplace id, e.g. MKT-DE"}
      category_id: {type: str, desc: "Marketplace category id"}
      status: {type: enum, values: [active, draft, rejected, submitted, in_review, paused, delisted], desc: Listing status}
      title: {type: str, desc: Marketplace product title}
      description_length: {type: int, desc: Description character count}
      has_images: {type: bool, desc: "Has product images"}
      has_video: {type: bool, desc: "Has product video"}
      attributes_complete: {type: float, desc: "% of required attributes completed"}
      submitted_at: {type: timestamp, desc: First submission date}
      rejected_at: {type: timestamp, desc: Most recent rejection date}
      rejection_count: {type: int, desc: Total rejection count}
      updated_at: {type: timestamp, desc: Last updated}
      resubmission_note: {type: text, desc: "Note stored with the latest resubmission, e.g. what was corrected"}

  listing_rejections:
    key: rejection_id
    cols:
      rejection_id: {type: str, desc: "Rejection record, e.g. REJ-000123"}
      listing_id: {type: str, desc: "Listing that was rejected"}
      sku: {type: str, desc: "SKU"}
      reason_code: {type: str, desc: "Rejection code, e.g. MISSING_IMAGE, INCOMPLETE_TITLE"}
      reason_text: {type: str, desc: "Human-readable rejection reason"}
      field_name: {type: str, desc: "Field with the issue, if applicable"}
      rejected_at: {type: timestamp, desc: When rejection occurred}
      is_fixable_in_bulk: {type: bool, desc: "Can be fixed programmatically"}
      suggested_fix: {type: text, desc: "How to fix it, e.g. fill EAN from PIM"}

  marketplace_categories:
    key: category_id
    cols:
      category_id: {type: str, desc: "Marketplace category, e.g. MKTCAT-001"}
      marketplace_id: {type: str, desc: "Marketplace, e.g. MKT-DE"}
      parent_category_id: {type: str, desc: "Parent category, if nested"}
      name: {type: str, desc: "Category name"}
      local_name: {type: str, desc: "Category name in marketplace language"}
      pim_category_match: {type: str, desc: "Corresponding PIM category"}

  marketplace_policies:
    key: policy_id
    cols:
      policy_id: {type: str, desc: "Policy change, e.g. POL-000123"}
      marketplace_id: {type: str, desc: "Marketplace id"}
      policy_type: {type: enum, values: [commission_fee, returns, listing_requirements, seller_agreement, other], desc: Policy type}
      effective_date: {type: date, desc: "When policy takes effect"}
      description: {type: str, desc: "Policy change description"}
      impact_summary: {type: str, desc: "Business impact"}
      previous_policy: {type: str, desc: "What it replaces"}
      announced_at: {type: timestamp, desc: "When announced"}
      est_margin_impact_pct: {type: float, desc: "Estimated margin impact in percentage points, negative = worse"}

  marketplace_fee_schedule:
    key: fee_id
    cols:
      fee_id: {type: str, desc: "Fee schedule entry, e.g. FEE-000123"}
      marketplace_id: {type: str, desc: "Marketplace id"}
      effective_date: {type: date, desc: "Fee effective from"}
      category_id: {type: str, desc: "Marketplace category"}
      pim_category: {type: str, desc: "PIM category"}
      commission_pct: {type: float, desc: "Commission percentage"}
      fixed_fee_gbp: {type: float, desc: "Fixed per-listing fee in GBP"}
      fulfillment_fee_gbp: {type: float, desc: "Fulfillment fee per unit in GBP"}
      previous_commission_pct: {type: float, desc: "Previous commission %"}

  marketplace_listing_requirements:
    key: requirement_id
    cols:
      requirement_id: {type: str, desc: "Requirement, e.g. REQ-000123"}
      marketplace_id: {type: str, desc: "Marketplace id"}
      category_id: {type: str, desc: "Marketplace category"}
      attribute_name: {type: str, desc: "Required attribute, e.g. brand, weight"}
      is_mandatory: {type: bool, desc: "Is this attribute mandatory"}
      description: {type: str, desc: "Requirement description"}
      format_rules: {type: str, desc: "Format/validation rules"}
      examples: {type: str, desc: "Example values"}
      effective_date: {type: date, desc: "When the requirement applies from"}
      policy_id: {type: str, desc: "Policy change that introduced it, e.g. POL-900007"}

  marketplace_content_requirements:
    key: content_req_id
    cols:
      content_req_id: {type: str, desc: "Content requirement, e.g. CONT-000123"}
      marketplace_id: {type: str, desc: "Marketplace id"}
      category_id: {type: str, desc: "Category id"}
      content_type: {type: enum, values: [title, description, images, video, attributes, SEO], desc: Content type}
      requirement: {type: str, desc: "Content requirement"}
      min_length: {type: int, desc: "Minimum length"}
      max_length: {type: int, desc: "Maximum length"}
      mandatory: {type: bool, desc: "Is mandatory"}
      examples: {type: str, desc: "Example content"}

  pim_attributes:
    key: attribute_id
    cols:
      attribute_id: {type: str, desc: "PIM attribute, e.g. ATTR-000123"}
      attribute_name: {type: str, desc: "Attribute name"}
      pim_category: {type: str, desc: "PIM category"}
      data_type: {type: enum, values: [text, number, enum, date, image], desc: Data type}
      is_mandatory: {type: bool, desc: "Mandatory in PIM"}
      description: {type: str, desc: "Attribute description"}
