id: cost_model
name: Cost Modelling Tool
instructions: >
  Cost analysis tools for sourcing, product engineering, supply chain strategy and capital investment.
  Build should-costs, compare quotes, model control options and evaluate make-vs-buy decisions.

tables:
  should_costs:
    key: cost_id
    cols:
      cost_id: {type: str, desc: "Should-cost id, e.g. SC-000123"}
      sku: {type: str, desc: "Product SKU, e.g. SKU-100234"}
      style_id: {type: str, desc: "Style, e.g. STY-5520"}
      volume_units: {type: int, desc: "Volume for this cost (base case)"}
      tooling_total_gbp: {type: float, desc: "One-off tooling cost in GBP, amortised over volume"}
      material_gbp: {type: float, desc: "Material cost per unit in GBP"}
      labour_gbp: {type: float, desc: "Labour cost per unit in GBP"}
      overhead_gbp: {type: float, desc: "Overhead allocation per unit in GBP"}
      freight_gbp: {type: float, desc: "Freight cost per unit in GBP"}
      tooling_per_unit_gbp: {type: float, desc: "Tooling amortised per unit in GBP"}
      margin_gbp: {type: float, desc: "Margin per unit in GBP"}
      total_gbp: {type: float, desc: "Total cost per unit in GBP"}
      region: {type: str, desc: "Manufacturing region, e.g. Vietnam, UK"}
      notes: {type: str, desc: "Notes on assumptions"}
      created_at: {type: timestamp, desc: "Calculation date"}

  cost_reduction_options:
    key: option_id
    cols:
      option_id: {type: str, desc: "Cost reduction option id, e.g. CRO-000123"}
      sku: {type: str, desc: "Product SKU, e.g. K-1700 or SKU-100234"}
      title: {type: str, desc: "Option title, e.g. Reduce wall thickness"}
      description: {type: str, desc: "Detailed description"}
      saving_gbp_per_unit: {type: float, desc: "Saving per unit in GBP"}
      saving_pct: {type: float, desc: "Saving as % of current unit cost"}
      implementation_cost_gbp: {type: float, desc: "Implementation cost in GBP"}
      customer_impact: {type: str, desc: "Likely customer impact: none, minor, moderate, significant"}
      status: {type: str, desc: "Status: proposed, tested, approved, implemented"}
      category: {type: str, desc: "Category: material, labour, overhead, design, packaging"}

  control_option_costs:
    key: control_id
    cols:
      control_id: {type: str, desc: "Control option id, e.g. CTL-000123"}
      control_type: {type: str, desc: "Type: pedestrian_exclusion, proximity_sensor, speed_limiter"}
      site_size_sqft: {type: int, desc: "DC floor area this cost tier was estimated for, in square feet"}
      capex_gbp: {type: float, desc: "Capital expenditure in GBP"}
      annual_opex_gbp: {type: float, desc: "Annual operating cost in GBP"}
      installation_weeks: {type: int, desc: "Installation duration in weeks"}
      incident_reduction_pct: {type: float, desc: "Expected reduction in incidents %"}
      notes: {type: str, desc: "Notes on assumptions"}

  lifecycle_scenarios:
    key: scenario_id
    cols:
      scenario_id: {type: str, desc: "Lifecycle scenario id, e.g. LCS-000123"}
      asset_id: {type: str, desc: "Asset id"}
      option_type: {type: str, desc: "Type: repair, overhaul, replace"}
      capex_gbp: {type: float, desc: "Capital expenditure in GBP (0 for repair)"}
      annual_maintenance_gbp: {type: float, desc: "Annual maintenance cost in GBP"}
      implementation_weeks: {type: int, desc: "Weeks to deliver the option (0 for repair)"}
      expected_life_years: {type: int, desc: "Expected life in years"}
      downtime_risk_high_pct: {type: float, desc: "% chance of a high-downtime year"}
      downtime_cost_if_high_gbp: {type: float, desc: "Cost of one high-downtime year in GBP (lost throughput, manual labour, expediting)"}
      residual_value_gbp: {type: float, desc: "Residual value after life (0 for dispose)"}
      notes: {type: str, desc: "Notes on assumptions"}

  labour_rates:
    key: rate_id
    cols:
      rate_id: {type: str, desc: "Labour rate id, e.g. LR-000123"}
      country: {type: str, desc: "Country code: VN, BD, TR or GB"}
      role: {type: str, desc: "Role: sewing, assembly, finishing, inspection, supervision"}
      hourly_gbp: {type: float, desc: "Hourly rate in GBP"}
      annual_hours: {type: int, desc: "Annual productive hours per worker"}
      trend_pct_annual: {type: float, desc: "Annual inflation trend %"}
      date_from: {type: date, desc: "Effective from date"}
      date_to: {type: date, desc: "Effective to date"}

  quote_components:
    key: quote_line_id
    cols:
      quote_line_id: {type: str, desc: "Quote line id, e.g. QL-000123"}
      sku: {type: str, desc: "Product SKU, e.g. K-1700 or SKU-100234"}
      supplier_id: {type: str, desc: "Supplier"}
      component_type: {type: str, desc: "Quote line type, e.g. material, fabric, trims, labour, overhead, tooling, finish, freight, margin"}
      component_desc: {type: str, desc: "Component description"}
      cost_gbp_per_unit: {type: float, desc: "Cost per unit in GBP"}
      volume_units: {type: int, desc: "Volume at this cost"}
      benchmark_gbp_per_unit: {type: float, desc: "Benchmark cost per unit for comparison"}
      variance_pct: {type: float, desc: "Variance from benchmark %"}
      comments: {type: str, desc: "Comments on variance"}

  cost_benchmarks:
    key: benchmark_id
    cols:
      benchmark_id: {type: str, desc: "Benchmark id, e.g. BM-000123"}
      component_type: {type: str, desc: "Type: material, labour, overhead, freight"}
      product_category: {type: str, desc: "Product category, e.g. apparel, homeware"}
      region: {type: str, desc: "Manufacturing region"}
      description: {type: str, desc: "Benchmark description"}
      benchmark_gbp_per_unit: {type: float, desc: "Benchmark cost per unit in GBP"}
      low_gbp_per_unit: {type: float, desc: "Low end (25th percentile) in GBP"}
      high_gbp_per_unit: {type: float, desc: "High end (75th percentile) in GBP"}
      source: {type: str, desc: "Data source"}
      date_from: {type: date, desc: "Effective from date"}

  investment_cases:
    key: case_id
    cols:
      case_id: {type: str, desc: "Investment case id, e.g. INV-000123"}
      title: {type: str, desc: "Investment title"}
      description: {type: str, desc: "Investment description"}
      capex_gbp: {type: float, desc: "Total capital expenditure in GBP"}
      annual_benefit_gbp: {type: float, desc: "Annual benefit in GBP"}
      implementation_years: {type: float, desc: "Implementation period in years"}
      evaluation_years: {type: int, desc: "Evaluation horizon in years"}
      discount_rate_pct: {type: float, desc: "Discount rate %"}
      tax_rate_pct: {type: float, desc: "Corporate tax rate %"}
      sensitivity_upside_pct: {type: float, desc: "Upside scenario benefit increase %"}
      sensitivity_downside_pct: {type: float, desc: "Downside scenario benefit reduction %"}
      risk_rating: {type: str, desc: "Risk rating: low, medium, high"}
      dependencies: {type: str, desc: "Dependencies; semicolon separated"}

  make_vs_buy:
    key: case_id
    cols:
      case_id: {type: str, desc: "Make vs buy case id, e.g. MVB-000123"}
      activity: {type: str, desc: "Activity or part of it, e.g. transport, transport: primary trunking, packaging"}
      description: {type: str, desc: "Description"}
      capex_in_house_gbp: {type: float, desc: "In-house capex in GBP (for transport: buying and fitting out our own fleet)"}
      annual_cost_in_house_gbp: {type: float, desc: "In-house annual cost in GBP"}
      capex_outsourced_gbp: {type: float, desc: "Outsourced capex in GBP"}
      annual_cost_outsourced_gbp: {type: float, desc: "Outsourced annual cost in GBP"}
      flex_benefit: {type: str, desc: "Flexibility gained by outsourcing: high, medium, low"}
      quality_risk: {type: str, desc: "Service quality risk of outsourcing: low, medium, high"}
      control_loss: {type: str, desc: "Control lost by outsourcing: none, some, moderate, significant"}
      transition_weeks: {type: int, desc: "Transition period in weeks"}
