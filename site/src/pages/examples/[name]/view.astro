---
// A full report inside the site: the site header stays, the report fills the rest of the window in a frame. The report
// is the same file as /examples/<name>/report.html (or compare.html); this page only frames it and keeps one theme.
import '../../../styles/mm-tokens.css';
import '../../../components/landing/landing.css';
import Header from '../../../components/landing/Header.astro';
import OutcomeBar from '../../../components/landing/OutcomeBar.astro';
import ThemeInit from '../../../components/landing/ThemeInit.astro';
import { data, href, mb } from '../../../components/examples/data';
import { BASE } from '../../../components/landing/model';

export function getStaticPaths() {
  return [...Object.keys(data.runs), ...Object.keys(data.comparisons)].map((name) => ({ params: { name } }));
}

const { name } = Astro.params;
const ex = name in data.runs ? data.runs[name as keyof typeof data.runs] : data.comparisons[name as keyof typeof data.comparisons];
const page = ex.files[0];
---
<html lang="en-GB" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{ex.title}: full report · mock-enterprise-MCP Benchmark</title>
    <link rel="icon" href={`${BASE}/favicon.svg`} type="image/svg+xml" />
    <ThemeInit />
  </head>
  <body class="viewer">
    <Header><OutcomeBar slot="stripe" /></Header>
    <div class="subbar">
      <div class="wrap subbar-in">
        <a class="back" href={href(`examples/${name}/`)}>← {ex.title}</a>
        <span class="size">{page.name}, {mb(page.bytes)}</span>
        <a class="solo" href={href(ex.report)} target="_blank" rel="noopener">Open on its own ↗</a>
      </div>
    </div>
    <iframe id="report" src={href(ex.report)} title={`${ex.title}: full report`}></iframe>
    <script is:inline>
      // One theme for the site and the framed report: the report reads `mm-theme` when it loads and honours data-theme on
      // its <html>; both pages share an origin, so both can be set from here, and the report's own theme switch is hidden
      // in favour of the header's. Links that leave the report (a task's answers or trace) open in a new tab so the
      // report stays put.
      (function () {
        var frame = document.getElementById('report'), root = document.documentElement;
        function push() {
          var t = root.dataset.theme;
          try { localStorage.setItem('mm-theme', t); } catch (e) {}
          try { frame.contentDocument.documentElement.setAttribute('data-theme', t); } catch (e) {}
        }
        push();
        frame.addEventListener('load', function () {
          push();
          try {
            var doc = frame.contentDocument, style = doc.createElement('style');
            style.textContent = '.seg:has(input[name=theme]){display:none}';
            doc.head.appendChild(style);
            doc.addEventListener('click', function (e) {
              var a = e.target.closest && e.target.closest('a[href]');
              if (a && a.getAttribute('href').charAt(0) !== '#' && !a.target) a.target = '_blank';
            }, true);
          } catch (e) {}
        });
        new MutationObserver(push).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
      })();
    </script>
  </body>
</html>

<style is:global>
  body.viewer { height: 100dvh; display: flex; flex-direction: column; overflow: hidden; }
  body.viewer > header { position: static; }
  .subbar { border-bottom: 1px solid var(--mm-grid); background: var(--mm-surface); font-size: 0.875rem; }
  .subbar-in { display: flex; align-items: center; gap: 8px 20px; min-height: 40px; flex-wrap: wrap; padding-top: 6px; padding-bottom: 6px; }
  .subbar a { color: var(--mm-fg); text-decoration: none; font-weight: 600; }
  .subbar a:hover { text-decoration: underline; }
  .subbar .size { color: var(--mm-muted); }
  .subbar .solo { margin-left: auto; font-weight: 500; color: var(--mm-muted); }
  #report { flex: 1; width: 100%; border: 0; display: block; background: var(--mm-bg); }
  @media (max-width: 600px) { .subbar .size { display: none; } }
</style>
