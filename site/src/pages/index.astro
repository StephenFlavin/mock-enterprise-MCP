---
// Landing page (package A). Every figure comes from src/data/examples.json or the repo at build time (landing/model.ts).
import '../styles/mm-tokens.css';
import '../components/landing/landing.css';
import ExampleReports from '../components/landing/ExampleReports.astro';
import Footer from '../components/landing/Footer.astro';
import Header from '../components/landing/Header.astro';
import Hero from '../components/landing/Hero.astro';
import HowItWorks from '../components/landing/HowItWorks.astro';
import OutcomeBar from '../components/landing/OutcomeBar.astro';
import QuickStart from '../components/landing/QuickStart.astro';
import Results from '../components/landing/Results.astro';
import ThemeInit from '../components/landing/ThemeInit.astro';
import { BASE, world } from '../components/landing/model';

const description = `${world.systems} mock enterprise systems, about ${world.tools} MCP tools, one fictional UK retailer: a benchmark for how well a model finds its way through MCP tools as more of them fill its context.`;
---
<html lang="en-GB" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>mock-enterprise-MCP Benchmark</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${BASE}/favicon.svg`} type="image/svg+xml" />
    <ThemeInit />
  </head>
  <body>
    <Header><OutcomeBar slot="stripe" /></Header>
    <main>
      <Hero />
      <Results />
      <HowItWorks />
      <ExampleReports />
      <QuickStart />
    </main>
    <Footer />
  </body>
</html>
