---
// Auto / Light / Dark, sharing Starlight's stored choice (localStorage 'starlight-theme': 'light' | 'dark' | '' for auto)
// so the theme carries between the landing page and the docs. ThemeInit.astro sets data-theme before first paint.
---
<div class="seg" role="group" aria-label="Colour theme" data-theme-switch>
  <button type="button" data-t="auto" aria-pressed="true">Auto</button><button type="button" data-t="light" aria-pressed="false">Light</button><button type="button" data-t="dark" aria-pressed="false">Dark</button>
</div>
<script>
  type Theme = 'auto' | 'light' | 'dark';
  const KEY = 'starlight-theme';
  const load = (): Theme => {
    try { const t = localStorage.getItem(KEY); return t === 'light' || t === 'dark' ? t : 'auto'; } catch { return 'auto'; }
  };
  const system = () => (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
  function apply(t: Theme, store: boolean) {
    document.documentElement.dataset.theme = t === 'auto' ? system() : t;
    document.querySelectorAll<HTMLButtonElement>('[data-theme-switch] button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.t === t)));
    if (store) try { localStorage.setItem(KEY, t === 'auto' ? '' : t); } catch { /* private mode: the choice lasts this page only */ }
  }
  document.querySelectorAll<HTMLButtonElement>('[data-theme-switch] button').forEach((b) => b.addEventListener('click', () => apply(b.dataset.t as Theme, true)));
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => { if (load() === 'auto') apply('auto', false); });
  apply(load(), false);
</script>
