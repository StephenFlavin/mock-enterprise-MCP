---
import Logo from './Logo.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { BASE, REPO } from './model';
---
<div class="stripe" aria-hidden="true"><slot name="stripe" /></div>
<header>
  <div class="wrap bar">
    <a class="brand" href={`${BASE}/`}>
      <Logo />
      <span>mock-enterprise-MCP <small>Benchmark</small></span>
    </a>
    <nav aria-label="Main">
      <a href={`${BASE}/get-started/introduction/`}>Get started</a>
      <a href={`${BASE}/examples/`}>Examples</a>
      <a href={`${BASE}/reference/benchmarking/`}>Reference</a>
      <a href={REPO}>GitHub</a>
    </nav>
    <ThemeSwitch />
  </div>
</header>
