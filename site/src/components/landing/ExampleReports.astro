---
import { cards } from './model';
const side = (s: string) => `--c:var(--mm-side-${s.toLowerCase()});--ink:var(--mm-ink-side-${s.toLowerCase()})`;
---
<section class="rule" id="examples">
  <div class="wrap">
    <p class="eyebrow">Example reports</p>
    <h2>Every run ends in a report you can explore</h2>
    <p class="lede">Each report is one HTML page that works offline: charts, the outcome of every task, and a drawer with the answer, the facts it found and the judge's reasoning.</p>
    <div class="ex">
      {cards.map((c) => (
        <a class="card excard" href={c.href}>
          <div class="shot"><img src={c.img} alt={c.alt} width="1440" height="900" loading="lazy" decoding="async" /></div>
          <div class="exbody">
            <div class="sides">{c.sides.map(([s, label]) => <span class="side" style={side(s)}><b>{s}</b>{label}</span>)}</div>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            <span class="go">{c.go}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
