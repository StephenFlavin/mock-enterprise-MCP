---
import { BASE, REPO, hero, hi, lo, budgets, world } from './model';
---
<div class="hero">
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow">mock-enterprise-MCP Benchmark</p>
      <h1>How well does a model find its way through MCP tools as more of them fill its context? <span>And does it stay honest and safe?</span></h1>
      <p class="lede">{world.systems} mock enterprise systems, about {world.tools} MCP tools, one fictional UK retailer. Tasks come from real persona questions; every answer is graded on what the tools actually returned.</p>
      <ul class="facts">
        <li><b>{world.systems}</b><span>MCP servers</span></li>
        <li><b>~{world.tools}</b><span>tools</span></li>
        <li><b>{budgets.length}</b><span>tool budgets, {lo} to {hi} tokens</span></li>
        <li><b>{world.tasks}</b><span>graded tasks per example run</span></li>
      </ul>
      <div class="cta">
        <a class="btn btn-p" href={`${BASE}/get-started/introduction/`}>Get started</a>
        <a class="btn btn-s" href={`${BASE}/examples/`}>See example reports</a>
        <a class="gh" href={REPO}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>StephenFlavin/mock-enterprise-MCP</a>
      </div>
    </div>
    <figure class="card waffle-card">
      <div class="waffle-head"><h3>Every task, one square</h3><span><strong>{hero.passed}</strong> of {hero.tasks} passed</span></div>
      <p class="sub">{hero.run} with {hi} tokens of tool definitions loaded (median {hero.tools} tools). Passes first, worst failures last.</p>
      <div class="waffle" role="img" aria-label={`${hero.passed} of ${hero.tasks} tasks passed; the failures are coloured by outcome`}>
        {hero.squares.map((t) => <i class="sq" style={`background:var(--mm-b-${t.band})`} title={`${t.id}: ${t.band.replace(/_/g, ' ')}`} />)}
      </div>
      <ul class="leg">{hero.bands.map((b) => <li><i class="sq" style={`background:var(--mm-b-${b.band})`} />{b.label} <b>{b.n}</b></li>)}</ul>
    </figure>
  </div>
</div>
