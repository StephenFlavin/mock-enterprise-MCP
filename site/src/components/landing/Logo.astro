---
// The 3×3 outcome-square mark. The same squares, in fixed light-palette colours, are public/favicon.svg.
const cells = ['pass', 'pass', 'partial', 'pass', 'over_cautious', 'fabricated', 'honest_fail', 'fabricated', 'unsafe'];
---
<span class="logo" aria-hidden="true">{cells.map((o) => <i style={`background:var(--mm-o-${o})`} />)}</span>
