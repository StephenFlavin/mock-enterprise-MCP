---
// Pass rate by tool budget as a line chart, y from 40% to 80%. `labels` puts the names at the line ends (wide layout);
// the narrow layout uses the HTML key above the chart instead.
import { budgets, pct0, series } from './model';

interface Props { W: number; H: number; ml: number; mr: number; mt: number; mb: number; fs: number; labels: boolean }
const { W, H, ml, mr, mt, mb, fs, labels } = Astro.props;
const lo = 0.4, hi = 0.8, grid = [0.4, 0.5, 0.6, 0.7, 0.8];
const pw = W - ml - mr, ph = H - mt - mb;
const X = (i: number) => ml + (pw * i) / (budgets.length - 1);
const Y = (v: number) => mt + (ph * (hi - v)) / (hi - lo);
const r = fs > 12 ? 4.5 : 3.5;
---
<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="chart-t chart-d" class="chart-svg" style={`font-size:${fs}px`}>
  {grid.map((g) => (
    <>
      <line x1={ml} x2={W - mr} y1={Y(g)} y2={Y(g)} class={g === lo ? 'ax' : 'gr'} />
      <text x={ml - 8} y={Y(g) + 4} text-anchor="end" class="tk">{pct0(g)}</text>
    </>
  ))}
  {budgets.map((b, i) => <text x={X(i)} y={H - mb + fs + 8} text-anchor="middle" class="tk">{b.label}</text>)}
  {series.map((s) => (
    <g>
      <polyline points={s.rates.map((v, i) => `${X(i).toFixed(1)},${Y(v).toFixed(1)}`).join(' ')} fill="none" stroke={s.colour}
        stroke-width="2.5" stroke-linejoin="round" stroke-dasharray={s.dashed ? '6 5' : undefined} />
      {s.rates.map((v, i) => (
        <circle cx={X(i)} cy={Y(v)} r={r} fill={s.dashed ? 'var(--mm-bg)' : s.colour} stroke={s.colour} stroke-width="2">
          <title>{`${s.name}, ${budgets[i].label} tokens: ${pct0(v)} passed (${s.passed[i]} of ${s.tasks[i]})`}</title>
        </circle>
      ))}
      {labels && (
        <text x={W - mr + 12} y={Y(s.rates[s.rates.length - 1]) + 5} class="el">
          <tspan class="el-n">{s.end}</tspan><tspan class="el-v" dx="6">{pct0(s.rates[s.rates.length - 1])}</tspan>
        </text>
      )}
    </g>
  ))}
</svg>
