---
// Inline in <head>: resolve the stored theme exactly as Starlight's ThemeProvider does, before first paint (no flash).
---
<script is:inline>
  (function () {
    var t = '';
    try { t = localStorage.getItem('starlight-theme') || ''; } catch (e) {}
    if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    document.documentElement.dataset.theme = t;
  })();
</script>
