---
// A comparison's pass rates by tool budget (compare.json's runs and all), run A in --mm-side-a and run B in --mm-side-b.
import './examples.css';
import { budgetLabel, data, int, pct, pts, pval, ratio, type PairName } from './data';

interface Props { name: PairName }
const c = data.comparisons[Astro.props.name];
const keys = data.budgets.map((b) => b.key) as (keyof typeof c.pass_rate.by_budget)[];
const rows = [...keys.map((k) => ({ label: budgetLabel(k), r: c.pass_rate.by_budget[k], all: false })),
  { label: 'All budgets', r: c.pass_rate.all, all: true }];
---
<div class="mm-table not-content">
  <table>
    <thead>
      <tr>
        <th scope="col">Tool budget</th>
        <th scope="col"><span class="mm-side a">{c.labels.a}</span></th>
        <th scope="col"><span class="mm-side b">{c.labels.b}</span></th>
        <th scope="col">Δ (B − A)</th>
        <th scope="col">p</th>
        <th scope="col">Only A passes</th>
        <th scope="col">Only B passes</th>
        <th scope="col">Cost B / A</th>
      </tr>
    </thead>
    <tbody>
      {rows.filter((x) => !x.all).map(({ label, r }) => (
        <tr>
          <th scope="row">{label}</th>
          <td>{pct(r.a)}</td><td>{pct(r.b)}</td><td>{pts(r.delta)}</td>
          <td class:list={{ sig: r.p < 0.05 }}>{pval(r.p)}</td>
          <td>{int(r.head_to_head.a_only)}</td><td>{int(r.head_to_head.b_only)}</td><td>{ratio(r.cost_ratio)}</td>
        </tr>
      ))}
    </tbody>
    <tfoot>
      {rows.filter((x) => x.all).map(({ label, r }) => (
        <tr>
          <th scope="row">{label}</th>
          <td>{pct(r.a)}</td><td>{pct(r.b)}</td><td>{pts(r.delta)}</td>
          <td class:list={{ sig: r.p < 0.05 }}>{pval(r.p)}</td>
          <td>{int(r.head_to_head.a_only)}</td><td>{int(r.head_to_head.b_only)}</td><td>{ratio(r.cost_ratio)}</td>
        </tr>
      ))}
    </tfoot>
  </table>
</div>
<p class="mm-note">Pass rates on the {int(c.pass_rate.all.common)} tasks both runs share. p is McNemar's exact test on the tasks only one side passed; under 0.05 is in bold.</p>
