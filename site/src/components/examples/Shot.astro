---
// A screenshot or report chart from public/examples, linked to the full-size file.
import { href } from './data';

interface Props { src: string; alt: string; caption?: string }
const { src, alt, caption } = Astro.props;
---
<figure class="mm-shot not-content">
  <a href={href(src)}><img src={href(src)} alt={alt} loading="lazy" decoding="async" /></a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .mm-shot { margin: 1.25rem 0; }
  img { display: block; width: 100%; height: auto; border: 1px solid var(--mm-grid); border-radius: 0.5rem; background: var(--mm-surface); }
  figcaption { margin-top: 0.4rem; font-size: var(--sl-text-sm); color: var(--mm-muted); }
</style>
