---
// The examples overview: one card per example with its headline figures from examples.json.
import './examples.css';
import { data, href, pct, pts, pval, usd } from './data';

const runs = Object.entries(data.runs);
const pairs = Object.entries(data.comparisons);
---
<div class="mm-cards not-content">
  {runs.map(([name, r]) => (
    <a class="card" href={href(`examples/${name}/`)}>
      <span class="kind">Single run</span>
      <strong>{r.title}</strong>
      <span class="stat"><b>{pct(r.pass_rate.all)}</b> pass rate over {r.tasks} tasks</span>
      <span class="stat">{usd(r.cost_usd.all)} model cost, {usd(r.cost_per_pass_usd.all)} per pass</span>
      <span class="bar" aria-hidden="true">
        {data.outcome_order.map((o) => <i style={`flex:${(r.outcomes as Record<string, number>)[o] ?? 0};background:var(--mm-o-${o})`}></i>)}
      </span>
    </a>
  ))}
  {pairs.map(([name, c]) => (
    <a class="card" href={href(`examples/${name}/`)}>
      <span class="kind">Comparison</span>
      <strong>{c.title}</strong>
      <span class="stat"><span class="mm-side a">{c.labels.a}</span> <b>{pct(c.pass_rate.all.a)}</b></span>
      <span class="stat"><span class="mm-side b">{c.labels.b}</span> <b>{pct(c.pass_rate.all.b)}</b></span>
      <span class="stat">{pts(c.pass_rate.all.delta)}, p = {pval(c.pass_rate.all.p)}</span>
    </a>
  ))}
</div>

<style>
  .mm-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 1rem; margin: 1.5rem 0; }
  .card { display: flex; flex-direction: column; gap: 0.35rem; padding: 1rem; border: 1px solid var(--mm-grid); border-radius: 0.6rem;
    background: var(--mm-surface); color: var(--mm-fg); text-decoration: none; }
  .card:hover, .card:focus-visible { border-color: var(--mm-axis); outline: 2px solid var(--mm-axis); }
  .kind { font-size: var(--sl-text-xs); text-transform: uppercase; letter-spacing: 0.05em; color: var(--mm-muted); }
  strong { font-size: var(--sl-text-lg); }
  .stat { font-size: var(--sl-text-sm); }
  .bar { display: flex; height: 0.5rem; border-radius: 0.25rem; overflow: hidden; margin-top: auto; gap: 1px; }
</style>
