---
// "Open the full report" and "Download files" for one example; sizes are the files' own (examples.json files[].bytes).
import './examples.css';
import { data, href, mb, type PairName, type RunName } from './data';

interface Props { name: RunName | PairName }
const { name } = Astro.props;
// The report opens framed under the site header (pages/examples/[name]/view.astro); the file itself is one link away.
const ex = name in data.runs ? data.runs[name as RunName] : data.comparisons[name as PairName];
const page = ex.files[0];
const what: Record<string, string> = {
  'report.html': 'the interactive report: works offline, carries every task',
  'compare.html': 'the interactive comparison: works offline, carries every task of both runs',
  'report.md': 'the same results as Markdown',
  'compare.md': 'the same results as Markdown',
  'report.json.gz': 'the machine-readable report',
  'compare.json.gz': 'the machine-readable comparison',
  'answers.tar.gz': "every task's answers.json and trace.jsonl (the tool calls)",
  'grading.tar.gz': "every task's checks.json and judge.json (the verdict)",
};
---
<div class="mm-links not-content">
  <a class="mm-open" href={href(`examples/${name}/view/`)}>
    <strong>Open the full report</strong>
    <span>{page.name}, {mb(page.bytes)}: large, give it a few seconds to load</span>
  </a>
  <a class="mm-solo" href={href(ex.report)} target="_blank" rel="noopener">or open {page.name} on its own ↗</a>
  <details>
    <summary>Download files</summary>
    <ul>
      {ex.files.map((f) => <li><a href={href(f.path)} download>{f.name}</a> <span>{mb(f.bytes)}, {what[f.name] ?? ''}</span></li>)}
      <li>SVG charts: {ex.charts.map((p, i) => <>{i > 0 && ', '}<a href={href(p)}>{p.split('/').pop()?.replace('.svg', '')}</a></>)}</li>
    </ul>
  </details>
</div>

<style>
  .mm-links { margin: 1.25rem 0; display: grid; gap: 0.75rem; }
  .mm-open { display: block; padding: 0.9rem 1.1rem; border-radius: 0.5rem; text-decoration: none;
    background: var(--mm-fg); color: var(--mm-bg); }
  .mm-open:hover, .mm-open:focus-visible { outline: 3px solid var(--mm-axis); outline-offset: 2px; }
  .mm-open strong { display: block; font-size: var(--sl-text-lg); }
  .mm-open span { font-size: var(--sl-text-sm); }
  .mm-solo { font-size: var(--sl-text-sm); color: var(--mm-muted); justify-self: start; margin-top: -0.4rem; }
  details { border: 1px solid var(--mm-grid); border-radius: 0.5rem; padding: 0.6rem 1rem; background: var(--mm-surface); }
  summary { cursor: pointer; font-weight: 600; color: var(--mm-fg); }
  ul { margin: 0.5rem 0 0; padding-left: 1.1rem; font-size: var(--sl-text-sm); }
  li { margin: 0.25rem 0; overflow-wrap: anywhere; }
  li span { color: var(--mm-muted); }
</style>
