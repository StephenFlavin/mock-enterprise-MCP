---
// A single-run example's results by tool budget, read from examples.json (report.json's summary and runs).
import './examples.css';
import OutcomeBar from './OutcomeBar.astro';
import { budgetLabel, data, int, pct, usd, type RunName } from './data';

interface Props { name: RunName }
const r = data.runs[Astro.props.name];
const keys = data.budgets.map((b) => b.key) as (keyof typeof r.passed_by_budget)[];
const best = Math.max(...keys.map((k) => r.pass_rate.by_budget[k]));
---
<div class="mm-table not-content">
  <table>
    <thead>
      <tr><th scope="col">Tool budget</th><th scope="col">Pass rate</th><th scope="col">Passed</th><th scope="col">Cost</th><th scope="col">Cost per pass</th></tr>
    </thead>
    <tbody>
      {keys.map((k) => (
        <tr>
          <th scope="row">{budgetLabel(k)}</th>
          <td class:list={{ best: r.pass_rate.by_budget[k] === best }}>{pct(r.pass_rate.by_budget[k])}</td>
          <td>{int(r.passed_by_budget[k])} / {int(r.tasks_by_budget[k])}</td>
          <td>{usd(r.cost_usd.by_budget[k])}</td>
          <td>{usd(r.cost_per_pass_usd.by_budget[k])}</td>
        </tr>
      ))}
    </tbody>
    <tfoot>
      <tr><th scope="row">All budgets</th><td>{pct(r.pass_rate.all)}</td><td>{int(r.passed)} / {int(r.tasks)}</td><td>{usd(r.cost_usd.all)}</td><td>{usd(r.cost_per_pass_usd.all)}</td></tr>
    </tfoot>
  </table>
</div>
<OutcomeBar outcomes={r.outcomes} label={`Outcomes of all ${r.tasks} tasks`} />
<p class="mm-note">Budgets are the tokens of tool definitions loaded per task (median). Cost is the model under test's; the judge cost {usd(r.judge_cost_usd)} more. The highest pass rate is in bold.</p>
