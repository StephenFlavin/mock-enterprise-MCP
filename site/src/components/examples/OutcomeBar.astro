---
// One run's outcomes as a stacked bar with a legend, in the reports' outcome colours.
import { data, int, outcomeLabel, pct } from './data';

interface Props { outcomes: Record<string, number>; label: string }
const { outcomes, label } = Astro.props;
const total = Object.values(outcomes).reduce((s, n) => s + n, 0);
const parts = data.outcome_order.map((o) => ({ o, n: outcomes[o] ?? 0 })).filter((p) => p.n > 0);
const defs = data.outcome_definitions as Record<string, string>;
---
<figure class="mm-outcomes not-content">
  <div class="mm-bar" role="img" aria-label={`${label}: ` + parts.map((p) => `${outcomeLabel(p.o)} ${p.n}`).join(', ')}>
    {parts.map((p) => <span style={`flex:${p.n};background:var(--mm-o-${p.o})`} title={`${outcomeLabel(p.o)}: ${p.n} (${pct(p.n / total)})`}></span>)}
  </div>
  <figcaption>
    <ul>
      {parts.map((p) => (
        <li title={defs[p.o]}><i style={`background:var(--mm-o-${p.o})`}></i>{outcomeLabel(p.o)} <b>{int(p.n)}</b> <span>({pct(p.n / total)})</span></li>
      ))}
    </ul>
  </figcaption>
</figure>

<style>
  .mm-outcomes { margin: 1rem 0; }
  .mm-bar { display: flex; height: 1.1rem; border-radius: 0.3rem; overflow: hidden; gap: 1px; background: var(--mm-grid); }
  .mm-bar span { min-width: 2px; }
  ul { list-style: none; padding: 0; margin: 0.5rem 0 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; font-size: var(--sl-text-sm); }
  li { display: flex; align-items: center; gap: 0.35rem; color: var(--mm-fg); }
  li span { color: var(--mm-muted); }
  i { display: inline-block; width: 0.75rem; height: 0.75rem; border-radius: 0.15rem; }
</style>
