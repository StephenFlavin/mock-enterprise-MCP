---
// A comparison's pass rates by task kind and question type, all budgets pooled (examples.json by_kind), with a
// dumbbell per row: run A's dot in --mm-side-a, run B's in --mm-side-b.
import './examples.css';
import { data, int, pct, pts, pval, type PairName } from './data';

interface Props { name: PairName }
const c = data.comparisons[Astro.props.name];
---
<div class="mm-table not-content">
  <table>
    <thead>
      <tr>
        <th scope="col">Tasks</th><th scope="col">n</th>
        <th scope="col"><span class="mm-side a">{c.labels.a}</span></th>
        <th scope="col"><span class="mm-side b">{c.labels.b}</span></th>
        <th scope="col" class="dumb-h">0–100%</th>
        <th scope="col">Δ (B − A)</th><th scope="col">p</th>
      </tr>
    </thead>
    <tbody>
      {c.by_kind.map((r) => (
        <tr>
          <th scope="row">{r.label}{r.small && <em> (small)</em>}</th>
          <td>{int(r.n)}</td><td>{pct(r.a)}</td><td>{pct(r.b)}</td>
          <td class="dumb" aria-hidden="true">
            <span class="track">
              <span class="line" style={`left:${100 * Math.min(r.a, r.b)}%;width:${100 * Math.abs(r.b - r.a)}%`}></span>
              <span class="dot a" style={`left:${100 * r.a}%`}></span>
              <span class="dot b" style={`left:${100 * r.b}%`}></span>
            </span>
          </td>
          <td>{pts(r.delta)}</td><td class:list={{ sig: r.p < 0.05 }}>{pval(r.p)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .dumb { width: 8rem; min-width: 6rem; }
  .track { position: relative; display: block; height: 0.8rem; border-left: 1px solid var(--mm-axis); border-right: 1px solid var(--mm-axis); }
  .line { position: absolute; top: 50%; height: 2px; margin-top: -1px; background: var(--mm-axis); }
  .dot { position: absolute; top: 50%; width: 0.7rem; height: 0.7rem; margin: -0.35rem 0 0 -0.35rem; border-radius: 50%; border: 1px solid var(--mm-bg); }
  .dot.a { background: var(--mm-side-a); }
  .dot.b { background: var(--mm-side-b); }
  .dumb-h { font-weight: 400; }
</style>
